{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/customer",
      "destination": "/index.html"
    },
    {
      "source": "/customer/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|favicon.ico|manifest.webmanifest|registerSW.js|sw.js|icon.svg|apple-touch-icon.png|pwa-.*).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
